# Copy to .env for local runs (never commit .env). GitHub uses Secrets/Variables instead.

# Storefront host used in <loc> (no scheme, no trailing slash)
STOREFRONT_DOMAIN=www.pepstores.com

# Admin host
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-07

# --- Credentials: choose ONE style ---

# A) Dev Dashboard app (current). App + store must be in the same Shopify org.
#    The build exchanges these for a short-lived token each run (client_credentials).
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# B) Legacy static token (only if you already have an admin-created custom app).
#    If set, this is used as-is and the client_credentials exchange is skipped.
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# bulk (default) | paginated | mock
SITEMAP_FETCH_MODE=bulk

# Optional
OUTPUT_DIR=dist
DRIFT_MAX_PCT=25
